<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#F6F0E8" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/widget_header_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="YORULUNE" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_summary_headline" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Today's priorities" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_task_line_1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text="Your next step" android:textSize="13sp" />
    <TextView android:id="@+id/widget_task_line_2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="A little progress" android:textSize="13sp" />
    <TextView android:id="@+id/widget_task_line_3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="At your own pace" android:textSize="12sp" />
    <LinearLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_progress_badge" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="Mode" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_footer_action" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="+ Open" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
